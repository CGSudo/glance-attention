{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Glance",
  "version": "0.1.0",
  "identifier": "io.github.cgsudo.glance",
  "build": {
    "beforeDevCommand": "npm --prefix ui run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm --prefix ui run build && node prepare-sidecar.mjs",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "windows": [{ "label": "main", "title": "Glance", "create": false, "width": 1440, "height": 960, "minWidth": 1100, "minHeight": 700, "dragDropEnabled": false }],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src ipc: http://ipc.localhost; media-src 'self' blob: data:; object-src 'none'; base-uri 'self'; form-action 'none'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "CGSudo",
    "copyright": "Copyright CGSudo",
    "shortDescription": "Offline visual attention prediction",
    "externalBin": ["binaries/glance"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "windows": { "nsis": { "installMode": "currentUser" } }
  },
  "plugins": { "shell": { "open": "^https://(github\\.com|saliency\\.tuebingen\\.ai|cgsudo\\.github\\.io)/" } }
}
